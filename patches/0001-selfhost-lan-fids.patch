diff --git a/frontend/js/i18n.js b/frontend/js/i18n.js
index 4d702c2..2127655 100644
--- a/frontend/js/i18n.js
+++ b/frontend/js/i18n.js
@@ -2,7 +2,7 @@
 // translator can edit one file without touching the others. English is the
 // canonical source — every other locale falls back to en for any missing key.
 import en from './i18n/en.js';
-import es from './i18n/es.js';
+import esRaw from './i18n/es.js';
 import fr from './i18n/fr.js';
 import de from './i18n/de.js';
 import pt from './i18n/pt.js';
@@ -11,11 +11,15 @@ import it from './i18n/it.js';
 import ja from './i18n/ja.js';
 import zh from './i18n/zh.js';
 
+const es = { ...en, ...esRaw };
 const fallback = en;
 const registry = { en, es, fr, de, pt, hi, it, ja, zh };
 
-let currentLang = localStorage.getItem('rd_lang') || navigator.language?.split('-')[0] || 'en';
-if (!registry[currentLang]) currentLang = 'en';
+let currentLang = localStorage.getItem('rd_lang') || 'es';
+if (currentLang === 'en' || !registry[currentLang]) {
+  currentLang = 'es';
+  localStorage.setItem('rd_lang', 'es');
+}
 
 function lookup(key) {
   return registry[currentLang]?.[key] ?? fallback[key] ?? key;
